# Alamat backend (karsajobs) yang dipanggil browser: Node IP + Node Port Service karsajobs (nodePort 30001).
# minikube di Windows memakai driver docker, sehingga IP node (minikube ip) tidak dapat dijangkau dari browser di host.
# Karena itu minikube dijalankan dengan "--ports=127.0.0.1:30000:30000,127.0.0.1:30001:30001" yang memetakan
# NodePort ke localhost; Node IP yang dipakai browser menjadi localhost.
VUE_APP_BACKEND=http://localhost:30001
